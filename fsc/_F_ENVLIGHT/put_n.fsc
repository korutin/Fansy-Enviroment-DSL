/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->put_n( %lines:LargeInt; %ind:Str; %name:Str; %value )
   -----------------------------------------------------------------------------
   Добавить числовое поле <<ИМЯ=число>>; пустое значение (NULL) пропускается.

   Параметры: как у put_s; %value - число (целое или дробное).
   ----------------------------------------------------------------------------- */
if ~IsBlank(%value) then
    ListAdd(%lines, %ind + %name + '=' + Trim(Str(%value)));
end
