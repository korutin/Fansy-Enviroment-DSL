/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->join_lines( %lst:List ):Str
   -----------------------------------------------------------------------------
   Склеить строки выгрузки в текст с переводами строк CR LF.

   Параметры: %lst - список строк.
   Возврат: текст.
   ----------------------------------------------------------------------------- */
var v_res, v_i, v_n;
v_res := '';
v_n := ListCount(%lst);
v_i := 0;
while v_i < v_n do
    if v_i > 0 then
        v_res := v_res + #13 + #10;
    end;
    v_res := v_res + ListGet(%lst, v_i);
    v_i := v_i + 1;
end;
v_res
