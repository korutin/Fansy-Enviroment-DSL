/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->put_z( %lines:LargeInt; %ind:Str; %name:Str; %value )
   -----------------------------------------------------------------------------
   Добавить числовое поле, значение по умолчанию которого в базе - ноль:
   NULL и 0 пропускаются, чтобы не засорять выгрузку.

   Параметры: как у put_s; %value - число.
   ----------------------------------------------------------------------------- */
if ~IsBlank(%value) then
    if %value <> 0 then
        ListAdd(%lines, %ind + %name + '=' + Trim(Str(%value)));
    end;
end
