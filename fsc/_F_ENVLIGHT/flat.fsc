/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->flat( %value ):Str
   -----------------------------------------------------------------------------
   Значение поля в одну строку: переводы строк заменяются пробелом, края
   обрезаются. Значение поля env-light не может занимать несколько строк.

   Параметры:
     %value - любое значение; NULL и пустая строка дают пустую строку.
   Возврат: строка без переводов строк.
   ----------------------------------------------------------------------------- */
var v_res;
v_res := '';
if ~IsBlank(%value) then
    v_res := Str(%value);
    v_res := replace(v_res, #13 + #10, ' ');
    v_res := replace(v_res, #10, ' ');
    v_res := replace(v_res, #13, ' ');
    v_res := Trim(v_res);
end;
v_res
