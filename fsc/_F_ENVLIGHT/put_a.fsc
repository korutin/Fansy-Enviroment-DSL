/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->put_a( %lines:LargeInt; %ind:Str; %name:Str; %seen:LargeInt;
      %value )
   -----------------------------------------------------------------------------
   Добавить поле-ссылку на банковский счёт <<ИМЯ=&алиас>>; если счёт не
   выгружен выше, вместо поля пишется комментарий.

   Параметры:
     %lines, %ind, %name - как у put_s;
     %seen  - дескриптор списка выгруженных объектов (ключи A<ID счёта>);
     %value - ID счёта (OD_FACE_ACCS.ID).
   ----------------------------------------------------------------------------- */
var v_id;
if ~IsBlank(%value) then
    v_id := Trim(Str(%value));
    if _F_ENVLIGHT->has(%seen, 'A' + v_id) = 1 then
        ListAdd(%lines, %ind + %name + '=&a' + v_id);
    else
        ListAdd(%lines, %ind + '# ' + %name + ': счёт ID=' + v_id + ' не выгружен');
    end;
end
