/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->ref_self( %id ):Int
   -----------------------------------------------------------------------------
   Привести ссылку на лицо к SELF_ID. Хранимые в таблицах ссылки на лица
   бывают на ID версии (OD_FACES.ID) или на SELF_ID; для первой версии они
   совпадают.

   Параметры: %id - ID лица.
   Возврат: SELF_ID либо NULL, если лица нет или %id пустой.
   ----------------------------------------------------------------------------- */
var v_res;
v_res := clear(0);
if ~IsBlank(%id) then
    v_res := Extract('Данные', [select max(SELF_ID) from OD_FACES where ID = :ID], %id);
end;
v_res
