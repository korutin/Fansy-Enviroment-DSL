/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->face_closure( %queue:LargeInt; %efrom:LargeInt; %eto:LargeInt )
   -----------------------------------------------------------------------------
   Замкнуть очередь лиц по ссылкам: для каждого лица очереди собрать лица, на
   которые оно ссылается, и так до тех пор, пока очередь не перестанет расти.
   Рекурсии нет - обход идёт по растущему списку.

   Параметры:
     %queue - очередь лиц; на входе - начальные лица (SELF_ID строками);
     %efrom, %eto - списки рёбер, заполняются.
   ----------------------------------------------------------------------------- */
var v_i;
v_i := 0;
while v_i < ListCount(%queue) do
    _F_ENVLIGHT->face_refs_add(%queue, %efrom, %eto, Int(ListGet(%queue, v_i)));
    v_i := v_i + 1;
end
