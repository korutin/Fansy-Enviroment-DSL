/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->fmt_date( %d:Date ):Str
   -----------------------------------------------------------------------------
   Дата в виде ДД.ММ.ГГГГ: так записываются значения-даты в полях блоков
   env-light (платформенные API_* разбирают этот вид надёжно).

   Параметры:
     %d - дата или дата-время (время отбрасывается).
   Возврат: строка ДД.ММ.ГГГГ.
   ----------------------------------------------------------------------------- */
var v_res;
v_res := format('%2.2d', Day(%d)) + '.' + format('%2.2d', Month(%d)) + '.' + Str(Year(%d));
v_res
