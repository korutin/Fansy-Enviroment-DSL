/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->add_uniq( %lst:LargeInt; %value )
   -----------------------------------------------------------------------------
   Добавить значение в список строкой, если его там ещё нет. Пустое значение
   пропускается.

   Параметры:
     %lst   - дескриптор списка (L.self);
     %value - добавляемое значение (число или строка).
   ----------------------------------------------------------------------------- */
var v_val;
if ~IsBlank(%value) then
    v_val := Trim(Str(%value));
    if _F_ENVLIGHT->has(%lst, v_val) = 0 then
        ListAdd(%lst, v_val);
    end;
end
