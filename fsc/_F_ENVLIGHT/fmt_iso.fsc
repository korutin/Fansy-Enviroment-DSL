/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->fmt_iso( %d:Date ):Str
   -----------------------------------------------------------------------------
   Дата в виде ГГГГ-ММ-ДД: так записывается as_of в блоках env-light
   (движок сравнивает такие строки по порядку, поэтому нужен именно этот вид).

   Параметры:
     %d - дата или дата-время (время отбрасывается).
   Возврат: строка ГГГГ-ММ-ДД.
   ----------------------------------------------------------------------------- */
var v_res;
v_res := Str(Year(%d)) + '-' + format('%2.2d', Month(%d)) + '-' + format('%2.2d', Day(%d));
v_res
