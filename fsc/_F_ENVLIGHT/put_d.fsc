/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->put_d( %lines:LargeInt; %ind:Str; %name:Str; %value )
   -----------------------------------------------------------------------------
   Добавить поле-дату <<ИМЯ=ДД.ММ.ГГГГ>>. Пустая дата и служебные границы
   (01.01.1900 - начало времён, 01.01.9999 - бесконечность) пропускаются:
   это значения по умолчанию, в сценарии они не нужны.

   Параметры: как у put_s; %value - дата или дата-время.
   ----------------------------------------------------------------------------- */
if ~IsBlank(%value) then
    if (Year(%value) > 1900) and (Year(%value) < 9999) then
        ListAdd(%lines, %ind + %name + '=' + _F_ENVLIGHT->fmt_date(%value));
    end;
end
