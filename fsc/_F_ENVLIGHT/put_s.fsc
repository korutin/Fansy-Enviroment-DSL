/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->put_s( %lines:LargeInt; %ind:Str; %name:Str; %value )
   -----------------------------------------------------------------------------
   Добавить строку <<ИМЯ=значение>> в выгрузку; пустое значение пропускается.

   Параметры:
     %lines - дескриптор списка строк выгрузки (L.self);
     %ind   - отступ строки;
     %name  - имя поля;
     %value - значение (строка).
   ----------------------------------------------------------------------------- */
var v_text;
v_text := _F_ENVLIGHT->flat(%value);
if v_text <> '' then
    ListAdd(%lines, %ind + %name + '=' + v_text);
end
