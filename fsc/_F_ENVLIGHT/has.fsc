/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->has( %lst:LargeInt; %value:Str ):Int
   -----------------------------------------------------------------------------
   Есть ли строка в списке.

   Параметры:
     %lst   - дескриптор списка (L.self);
     %value - искомая строка (сравнение точное).
   Возврат: 1 - есть, 0 - нет.
   ----------------------------------------------------------------------------- */
var v_i, v_n;
v_n := ListCount(%lst);
v_i := 0;
while v_i < v_n do
    if ListGet(%lst, v_i) = %value then
        return(1);
    end;
    v_i := v_i + 1;
end;
0
