/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->add_face_seed( %queue:LargeInt; %id )
   -----------------------------------------------------------------------------
   Добавить лицо в очередь обхода (по SELF_ID), если оно есть и не добавлено.

   Параметры:
     %queue - дескриптор очереди лиц (L.self);
     %id    - ID лица (OD_FACES.ID или SELF_ID); пустое пропускается.
   ----------------------------------------------------------------------------- */
var v_self;
v_self := _F_ENVLIGHT->ref_self(%id);
if ~IsBlank(v_self) then
    _F_ENVLIGHT->add_uniq(%queue, v_self);
end
