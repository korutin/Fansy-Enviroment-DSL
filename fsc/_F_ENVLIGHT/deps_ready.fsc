/* -----------------------------------------------------------------------------
   _F_ENVLIGHT->deps_ready( %seen:LargeInt; %efrom:LargeInt; %eto:LargeInt;
      %id:Int ):Int
   -----------------------------------------------------------------------------
   Выгружены ли уже все лица, на которые ссылается лицо %id.

   Параметры:
     %seen        - список выгруженных объектов (ключи F<SELF_ID>);
     %efrom, %eto - списки рёбер графа ссылок;
     %id          - SELF_ID проверяемого лица.
   Возврат: 1 - все зависимости выгружены, 0 - есть невыгруженные.
   ----------------------------------------------------------------------------- */
var v_k, v_n, v_id;
v_id := Trim(Str(%id));
v_n := ListCount(%efrom);
v_k := 0;
while v_k < v_n do
    if ListGet(%efrom, v_k) = v_id then
        if _F_ENVLIGHT->has(%seen, 'F' + ListGet(%eto, v_k)) = 0 then
            return(0);
        end;
    end;
    v_k := v_k + 1;
end;
1
