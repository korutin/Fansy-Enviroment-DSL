990043\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990043\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->xwalk_REESTR_SUBTYPE( %code:Int ):Str
990043\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990043\DICMETAF.FUNC_BODY.03=   Вид лицевого счёта.
990043\DICMETAF.FUNC_BODY.04=   Обратное направление: код классификатора -> мнемоника env-light
990043\DICMETAF.FUNC_BODY.05=   (REESTR_SUBTYPE, cte/mnemonics.py). Неизвестный код возвращается числом как есть.
990043\DICMETAF.FUNC_BODY.07=   Параметры: %code - код (NUM в OD_SYS_TABS).
990043\DICMETAF.FUNC_BODY.08=   Возврат: мнемоника либо число строкой.
990043\DICMETAF.FUNC_BODY.09=   ----------------------------------------------------------------------------- */
990043\DICMETAF.FUNC_BODY.10=var v_res, v_key, LiX;
990043\DICMETAF.FUNC_BODY.11=v_key := Trim(Str(%code));
990043\DICMETAF.FUNC_BODY.12=LiX := List('1=owner', '2=nominee', '3=trustee', '4=add_units', '5=pledge',
990043\DICMETAF.FUNC_BODY.13=            '6=issued_units', '7=fund', '8=unidentified', '9=deposit',
990043\DICMETAF.FUNC_BODY.14=            '10=issuer_treasury', '102=nominee_cdep');
990043\DICMETAF.FUNC_BODY.15=v_res := ListVal(LiX, v_key);
990043\DICMETAF.FUNC_BODY.16=if IsBlank(v_res) then
990043\DICMETAF.FUNC_BODY.17=    v_res := v_key;
990043\DICMETAF.FUNC_BODY.18=end;
990043\DICMETAF.FUNC_BODY.19=v_res
990043\DICMETAF.FUNC_BODY.COUNT=20
990043\DICMETAF.FUNC_HEADER.0=xwalk_REESTR_SUBTYPE( %code:Int ):Str
990043\DICMETAF.FUNC_HEADER.COUNT=1
