990025\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990025\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_face_juridical( %lines:LargeInt; %ind:Str; %seen:LargeInt;
990025\DICMETAF.FUNC_BODY.02=      %id:Int )
990025\DICMETAF.FUNC_BODY.03=   -----------------------------------------------------------------------------
990025\DICMETAF.FUNC_BODY.04=   Поля версии юрлица из OD_U_FACES, в именах полей API_UPD_FACE.
990025\DICMETAF.FUNC_BODY.05=   Поля EXEC_ORGAN, NAL_ORGAN, DEPOT, REESTR - ссылки на лица, пишутся как
990025\DICMETAF.FUNC_BODY.06=   <<ИМЯ=&алиас>> (лица к этому моменту уже выгружены).
990025\DICMETAF.FUNC_BODY.08=   Параметры:
990025\DICMETAF.FUNC_BODY.09=     %lines - список строк выгрузки; %ind - отступ полей;
990025\DICMETAF.FUNC_BODY.10=     %seen  - список выгруженных объектов;
990025\DICMETAF.FUNC_BODY.11=     %id    - OD_FACES.ID версии лица (OD_U_FACES.FACE).
990025\DICMETAF.FUNC_BODY.12=   ----------------------------------------------------------------------------- */
990025\DICMETAF.FUNC_BODY.13=var FULL_NAME, ENG_FULL_NAME, OPF, OKPO, OKONX, OGRN, OGRN_DATE, OGRN_PLACE, OKOGU,
990025\DICMETAF.FUNC_BODY.14=    OKATO, FS, CAPITAL, ENSURNUM, DEP_NUM, DEP_DAT, DEPOT, REESTR, EXEC_ORGAN,
990025\DICMETAF.FUNC_BODY.15=    NAL_ORGAN, DOL_1, FIO_1, TEL_1, OSN_1, DOL_2, FIO_2, TEL_2, OSN_2, DOL_OTV,
990025\DICMETAF.FUNC_BODY.16=    FIO_OTV, TEL_OTV, FIO_BUG, TEL_BUG;
990025\DICMETAF.FUNC_BODY.17=for 'Данные' select [select FULL_NAME, ENG_FULL_NAME, OPF, OKPO, OKONX, OGRN, OGRN_DATE,
990025\DICMETAF.FUNC_BODY.18=                     OGRN_PLACE, OKOGU, OKATO, FS, CAPITAL, ENSURNUM, DEP_NUM,
990025\DICMETAF.FUNC_BODY.19=                     DEP_DAT, DEPOT, REESTR, EXEC_ORGAN, NAL_ORGAN, DOL_1, FIO_1,
990025\DICMETAF.FUNC_BODY.20=                     TEL_1, OSN_1, DOL_2, FIO_2, TEL_2, OSN_2, DOL_OTV, FIO_OTV,
990025\DICMETAF.FUNC_BODY.21=                     TEL_OTV, FIO_BUG, TEL_BUG
990025\DICMETAF.FUNC_BODY.22=                     from OD_U_FACES
990025\DICMETAF.FUNC_BODY.23=                     where FACE = :FACE]
990025\DICMETAF.FUNC_BODY.24=from %id
990025\DICMETAF.FUNC_BODY.25=into FULL_NAME, ENG_FULL_NAME, OPF, OKPO, OKONX, OGRN, OGRN_DATE, OGRN_PLACE, OKOGU,
990025\DICMETAF.FUNC_BODY.26=     OKATO, FS, CAPITAL, ENSURNUM, DEP_NUM, DEP_DAT, DEPOT, REESTR, EXEC_ORGAN,
990025\DICMETAF.FUNC_BODY.27=     NAL_ORGAN, DOL_1, FIO_1, TEL_1, OSN_1, DOL_2, FIO_2, TEL_2, OSN_2, DOL_OTV,
990025\DICMETAF.FUNC_BODY.28=     FIO_OTV, TEL_OTV, FIO_BUG, TEL_BUG
990025\DICMETAF.FUNC_BODY.29=do
990025\DICMETAF.FUNC_BODY.30=    _F_ENVLIGHT->put_s(%lines, %ind, 'FULL_NAME', FULL_NAME);
990025\DICMETAF.FUNC_BODY.31=    _F_ENVLIGHT->put_s(%lines, %ind, 'ENG_FULL_NAME', ENG_FULL_NAME);
990025\DICMETAF.FUNC_BODY.32=    _F_ENVLIGHT->put_s(%lines, %ind, 'OPF', OPF);
990025\DICMETAF.FUNC_BODY.33=    _F_ENVLIGHT->put_s(%lines, %ind, 'OKPO', OKPO);
990025\DICMETAF.FUNC_BODY.34=    _F_ENVLIGHT->put_s(%lines, %ind, 'OKONX', OKONX);
990025\DICMETAF.FUNC_BODY.35=    _F_ENVLIGHT->put_s(%lines, %ind, 'OGRN', OGRN);
990025\DICMETAF.FUNC_BODY.36=    _F_ENVLIGHT->put_d(%lines, %ind, 'OGRN_DATE', OGRN_DATE);
990025\DICMETAF.FUNC_BODY.37=    _F_ENVLIGHT->put_s(%lines, %ind, 'OGRN_PLACE', OGRN_PLACE);
990025\DICMETAF.FUNC_BODY.38=    _F_ENVLIGHT->put_s(%lines, %ind, 'OKOGU', OKOGU);
990025\DICMETAF.FUNC_BODY.39=    _F_ENVLIGHT->put_s(%lines, %ind, 'OKATO', OKATO);
990025\DICMETAF.FUNC_BODY.40=    _F_ENVLIGHT->put_n(%lines, %ind, 'FS', FS);
990025\DICMETAF.FUNC_BODY.41=    _F_ENVLIGHT->put_n(%lines, %ind, 'CAPITAL', CAPITAL);
990025\DICMETAF.FUNC_BODY.42=    _F_ENVLIGHT->put_s(%lines, %ind, 'ENSURNUM', ENSURNUM);
990025\DICMETAF.FUNC_BODY.43=    _F_ENVLIGHT->put_s(%lines, %ind, 'DEP_NUM', DEP_NUM);
990025\DICMETAF.FUNC_BODY.44=    _F_ENVLIGHT->put_d(%lines, %ind, 'DEP_DAT', DEP_DAT);
990025\DICMETAF.FUNC_BODY.45=    _F_ENVLIGHT->put_f(%lines, %ind, 'DEPOT', %seen, DEPOT);
990025\DICMETAF.FUNC_BODY.46=    _F_ENVLIGHT->put_f(%lines, %ind, 'REESTR', %seen, REESTR);
990025\DICMETAF.FUNC_BODY.47=    _F_ENVLIGHT->put_f(%lines, %ind, 'EXEC_ORGAN', %seen, EXEC_ORGAN);
990025\DICMETAF.FUNC_BODY.48=    _F_ENVLIGHT->put_f(%lines, %ind, 'NAL_ORGAN', %seen, NAL_ORGAN);
990025\DICMETAF.FUNC_BODY.49=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOL_1', DOL_1);
990025\DICMETAF.FUNC_BODY.50=    _F_ENVLIGHT->put_s(%lines, %ind, 'FIO_1', FIO_1);
990025\DICMETAF.FUNC_BODY.51=    _F_ENVLIGHT->put_s(%lines, %ind, 'TEL_1', TEL_1);
990025\DICMETAF.FUNC_BODY.52=    _F_ENVLIGHT->put_s(%lines, %ind, 'OSN_1', OSN_1);
990025\DICMETAF.FUNC_BODY.53=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOL_2', DOL_2);
990025\DICMETAF.FUNC_BODY.54=    _F_ENVLIGHT->put_s(%lines, %ind, 'FIO_2', FIO_2);
990025\DICMETAF.FUNC_BODY.55=    _F_ENVLIGHT->put_s(%lines, %ind, 'TEL_2', TEL_2);
990025\DICMETAF.FUNC_BODY.56=    _F_ENVLIGHT->put_s(%lines, %ind, 'OSN_2', OSN_2);
990025\DICMETAF.FUNC_BODY.57=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOL_OTV', DOL_OTV);
990025\DICMETAF.FUNC_BODY.58=    _F_ENVLIGHT->put_s(%lines, %ind, 'FIO_OTV', FIO_OTV);
990025\DICMETAF.FUNC_BODY.59=    _F_ENVLIGHT->put_s(%lines, %ind, 'TEL_OTV', TEL_OTV);
990025\DICMETAF.FUNC_BODY.60=    _F_ENVLIGHT->put_s(%lines, %ind, 'FIO_BUG', FIO_BUG);
990025\DICMETAF.FUNC_BODY.61=    _F_ENVLIGHT->put_s(%lines, %ind, 'TEL_BUG', TEL_BUG);
990025\DICMETAF.FUNC_BODY.62=end
990025\DICMETAF.FUNC_BODY.COUNT=63
990025\DICMETAF.FUNC_HEADER.0=out_face_juridical( %lines:LargeInt; %ind:Str; %seen:LargeInt;
990025\DICMETAF.FUNC_HEADER.1=   %id:Int )
990025\DICMETAF.FUNC_HEADER.COUNT=2
990025\DICMETAF.FUNC_ID=out_face_juridical
990025\DICMETAF.IS_CANON=0
990025\DICMETAF.IS_USER=1
990025\DICMETAF.MD5_HASH=062eefad00e04b3cc86d6e4eba4a87f1
990025\DICMETAF.MD5_STAMP=01.11.2026
990026\DICMETAF.FORM_NUM=990000
990026\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990026\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share( %lines:LargeInt; %seen:LargeInt; %share_id:Int )
990026\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990026\DICMETAF.FUNC_BODY.03=   Выгрузить финансовый инструмент блоками "share &s<ID>: <вид>". Каждая
990026\DICMETAF.FUNC_BODY.04=   версия (OD_SHARES) - отдельный блок: первая без as_of, следующие с
990026\DICMETAF.FUNC_BODY.05=   as_of=ГГГГ-ММ-ДД. В первом блоке - SYSNAME и эмитент ISSUER (ссылка на лицо),
990026\DICMETAF.FUNC_BODY.06=   поля OD_VALUES (MFU, IS_IN) и, для паёв, ID_TYPE фонда. В каждом блоке -
990026\DICMETAF.FUNC_BODY.07=   NAME, ISIN, CFI на дату версии, поля OD_SHARES и поля таблицы вида
990026\DICMETAF.FUNC_BODY.08=   инструмента: акции и паи (1, 10) - OD_A_SHARES, облигации и банковские
990026\DICMETAF.FUNC_BODY.09=   сертификаты (2, 6) - OD_O_SHARES, векселя (3) - OD_V_SHARES, опционы,
990026\DICMETAF.FUNC_BODY.10=   фьючерсы и депозитарные расписки (4, 5, 7) - OD_T_SHARES.
990026\DICMETAF.FUNC_BODY.11=   Лица, на которые ссылается инструмент, должны быть выгружены раньше.
990026\DICMETAF.FUNC_BODY.12=   В конце инструмент отмечается в %seen ключом S<ID>.
990026\DICMETAF.FUNC_BODY.14=   Параметры:
990026\DICMETAF.FUNC_BODY.15=     %lines    - список строк выгрузки;
990026\DICMETAF.FUNC_BODY.16=     %seen     - список выгруженных объектов, дополняется;
990026\DICMETAF.FUNC_BODY.17=     %share_id - SELF_ID инструмента (OD_VALUES.ID).
990026\DICMETAF.FUNC_BODY.18=   ----------------------------------------------------------------------------- */
990026\DICMETAF.FUNC_BODY.19=var ID, B_DATE, CLASS, ISSUER, ID_TYPE;
990026\DICMETAF.FUNC_BODY.20=var v_alias, v_n, v_ind;
990026\DICMETAF.FUNC_BODY.21=v_alias := 's' + Trim(Str(%share_id));
990026\DICMETAF.FUNC_BODY.22=v_ind := '  ';
990026\DICMETAF.FUNC_BODY.23=v_n := 0;
990026\DICMETAF.FUNC_BODY.24=for 'Данные' select [select ID, B_DATE, CLASS, ISSUER
990026\DICMETAF.FUNC_BODY.25=                     from OD_SHARES
990026\DICMETAF.FUNC_BODY.26=                     where SELF_ID = :SELF_ID and B_DATE <> E_DATE
990026\DICMETAF.FUNC_BODY.27=                     order by B_DATE]
990026\DICMETAF.FUNC_BODY.28=from %share_id
990026\DICMETAF.FUNC_BODY.29=into ID, B_DATE, CLASS, ISSUER
990026\DICMETAF.FUNC_BODY.30=do
990026\DICMETAF.FUNC_BODY.31=    v_n := v_n + 1;
990026\DICMETAF.FUNC_BODY.32=    if v_n = 1 then
990026\DICMETAF.FUNC_BODY.33=        ListAdd(%lines, '');
990026\DICMETAF.FUNC_BODY.34=        ListAdd(%lines, '# финансовый инструмент SELF_ID=' + Trim(Str(%share_id)));
990026\DICMETAF.FUNC_BODY.35=    end;
990026\DICMETAF.FUNC_BODY.36=    ListAdd(%lines, 'share &' + v_alias + ': ' + _F_ENVLIGHT->xwalk_SHARE_CLASS(CLASS));
990026\DICMETAF.FUNC_BODY.37=    if v_n > 1 then
990026\DICMETAF.FUNC_BODY.38=        ListAdd(%lines, v_ind + 'as_of=' + _F_ENVLIGHT->fmt_iso(B_DATE));
990026\DICMETAF.FUNC_BODY.39=    end;
990026\DICMETAF.FUNC_BODY.40=    if v_n = 1 then
990026\DICMETAF.FUNC_BODY.41=        _F_ENVLIGHT->out_share_values(%lines, v_ind, %share_id);
990026\DICMETAF.FUNC_BODY.42=        _F_ENVLIGHT->put_f(%lines, v_ind, 'ISSUER', %seen, ISSUER);
990026\DICMETAF.FUNC_BODY.43=        if CLASS = 10 then
990026\DICMETAF.FUNC_BODY.44=            ID_TYPE := Extract('Данные', [select max(ID_TYPE) from OD_FUNDS where U_FACE = :U_FACE], ISSUER);
990026\DICMETAF.FUNC_BODY.45=            _F_ENVLIGHT->put_n(%lines, v_ind, 'ID_TYPE', ID_TYPE);
990026\DICMETAF.FUNC_BODY.46=        end;
990026\DICMETAF.FUNC_BODY.47=    end;
990026\DICMETAF.FUNC_BODY.48=    _F_ENVLIGHT->out_share_opts(%lines, v_ind, %share_id, B_DATE);
990026\DICMETAF.FUNC_BODY.49=    _F_ENVLIGHT->out_share_main(%lines, v_ind, %seen, ID);
990026\DICMETAF.FUNC_BODY.50=    if (CLASS = 1) or (CLASS = 10) then
990026\DICMETAF.FUNC_BODY.51=        _F_ENVLIGHT->out_share_a(%lines, v_ind, ID);
990026\DICMETAF.FUNC_BODY.52=    elsif (CLASS = 2) or (CLASS = 6) then
990026\DICMETAF.FUNC_BODY.53=        _F_ENVLIGHT->out_share_o(%lines, v_ind, %seen, ID);
990026\DICMETAF.FUNC_BODY.54=    elsif CLASS = 3 then
990026\DICMETAF.FUNC_BODY.55=        _F_ENVLIGHT->out_share_v(%lines, v_ind, %seen, ID);
990026\DICMETAF.FUNC_BODY.56=    elsif (CLASS = 4) or (CLASS = 5) or (CLASS = 7) then
990026\DICMETAF.FUNC_BODY.57=        _F_ENVLIGHT->out_share_t(%lines, v_ind, %seen, ID);
990026\DICMETAF.FUNC_BODY.58=    end;
990026\DICMETAF.FUNC_BODY.59=end;
990026\DICMETAF.FUNC_BODY.60=ListAdd(%seen, 'S' + Trim(Str(%share_id)))
990026\DICMETAF.FUNC_BODY.COUNT=61
990026\DICMETAF.FUNC_HEADER.0=out_share( %lines:LargeInt; %seen:LargeInt; %share_id:Int )
990026\DICMETAF.FUNC_HEADER.COUNT=1
990026\DICMETAF.FUNC_ID=out_share
990026\DICMETAF.IS_CANON=0
990026\DICMETAF.IS_USER=1
990026\DICMETAF.MD5_HASH=7981e5d317fffbe3522b299a1116ea67
990026\DICMETAF.MD5_STAMP=01.11.2026
990027\DICMETAF.FORM_NUM=990000
990027\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990027\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_a( %lines:LargeInt; %ind:Str; %id:Int )
990027\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990027\DICMETAF.FUNC_BODY.03=   Поля акции/пая из OD_A_SHARES (права по акциям).
990027\DICMETAF.FUNC_BODY.05=   Параметры: %lines, %ind - как выше; %id - OD_SHARES.ID версии.
990027\DICMETAF.FUNC_BODY.06=   ----------------------------------------------------------------------------- */
990027\DICMETAF.FUNC_BODY.07=var VOICECOUNT, MAXSHARE, MAXVOICE, MAXNOMINAL, DIVID_TYPE, DIVID_RATE, DIVID_PERIOD,
990027\DICMETAF.FUNC_BODY.08=    RIGHTS_SET;
990027\DICMETAF.FUNC_BODY.09=for 'Данные' select [select VOICECOUNT, MAXSHARE, MAXVOICE, MAXNOMINAL, DIVID_TYPE,
990027\DICMETAF.FUNC_BODY.10=                     DIVID_RATE, DIVID_PERIOD, RIGHTS_SET
990027\DICMETAF.FUNC_BODY.11=                     from OD_A_SHARES
990027\DICMETAF.FUNC_BODY.12=                     where SHARE = :SHARE]
990027\DICMETAF.FUNC_BODY.13=from %id
990027\DICMETAF.FUNC_BODY.14=into VOICECOUNT, MAXSHARE, MAXVOICE, MAXNOMINAL, DIVID_TYPE, DIVID_RATE, DIVID_PERIOD,
990027\DICMETAF.FUNC_BODY.15=     RIGHTS_SET
990027\DICMETAF.FUNC_BODY.16=do
990027\DICMETAF.FUNC_BODY.17=    _F_ENVLIGHT->put_n(%lines, %ind, 'VOICECOUNT', VOICECOUNT);
990027\DICMETAF.FUNC_BODY.18=    _F_ENVLIGHT->put_n(%lines, %ind, 'MAXSHARE', MAXSHARE);
990027\DICMETAF.FUNC_BODY.19=    _F_ENVLIGHT->put_n(%lines, %ind, 'MAXVOICE', MAXVOICE);
990027\DICMETAF.FUNC_BODY.20=    _F_ENVLIGHT->put_n(%lines, %ind, 'MAXNOMINAL', MAXNOMINAL);
990027\DICMETAF.FUNC_BODY.21=    _F_ENVLIGHT->put_z(%lines, %ind, 'DIVID_TYPE', DIVID_TYPE);
990027\DICMETAF.FUNC_BODY.22=    _F_ENVLIGHT->put_z(%lines, %ind, 'DIVID_RATE', DIVID_RATE);
990027\DICMETAF.FUNC_BODY.23=    _F_ENVLIGHT->put_n(%lines, %ind, 'DIVID_PERIOD', DIVID_PERIOD);
990027\DICMETAF.FUNC_BODY.24=    _F_ENVLIGHT->put_z(%lines, %ind, 'RIGHTS_SET', RIGHTS_SET);
990027\DICMETAF.FUNC_BODY.25=end
990027\DICMETAF.FUNC_BODY.COUNT=26
990027\DICMETAF.FUNC_HEADER.0=out_share_a( %lines:LargeInt; %ind:Str; %id:Int )
990027\DICMETAF.FUNC_HEADER.COUNT=1
990027\DICMETAF.FUNC_ID=out_share_a
990027\DICMETAF.IS_CANON=0
990027\DICMETAF.IS_USER=1
990027\DICMETAF.MD5_HASH=8ed14493c5d992a693f5fa62c017ec16
990027\DICMETAF.MD5_STAMP=01.11.2026
990028\DICMETAF.FORM_NUM=990000
990028\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990028\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_main( %lines:LargeInt; %ind:Str; %seen:LargeInt;
990028\DICMETAF.FUNC_BODY.02=      %id:Int )
990028\DICMETAF.FUNC_BODY.03=   -----------------------------------------------------------------------------
990028\DICMETAF.FUNC_BODY.04=   Поля версии финансового инструмента из OD_SHARES, в именах полей
990028\DICMETAF.FUNC_BODY.05=   API_UPD_SHARE. Вид инструмента (CLASS) и эмитент (ISSUER) пишутся в
990028\DICMETAF.FUNC_BODY.06=   заголовок блока и поле out_share. Код валюты номинала NOM_VAL выводится
990028\DICMETAF.FUNC_BODY.07=   числом, только если он не равен базовой валюте базы. Не выводится LINK.
990028\DICMETAF.FUNC_BODY.09=   Параметры:
990028\DICMETAF.FUNC_BODY.10=     %lines - список строк выгрузки; %ind - отступ полей;
990028\DICMETAF.FUNC_BODY.11=     %seen  - список выгруженных объектов;
990028\DICMETAF.FUNC_BODY.12=     %id    - OD_SHARES.ID версии.
990028\DICMETAF.FUNC_BODY.13=   ----------------------------------------------------------------------------- */
990028\DICMETAF.FUNC_BODY.14=var MNEM, BIRTHDATE, DEATHDATE, DATE_REG, MODE, NOMINAL, COUNT_, ISNUM, NUM_REG,
990028\DICMETAF.FUNC_BODY.15=    NOM_VAL, ORG_REG, ISSUENUM, TYPE_, STATUS, PMFU, IS_MCS, IS_MARGIN, NOM_TYPE,
990028\DICMETAF.FUNC_BODY.16=    REP_DATE, BASE_CURR;
990028\DICMETAF.FUNC_BODY.17=for 'Данные' select [select MNEM, BIRTHDATE, DEATHDATE, DATE_REG, MODE, NOMINAL, COUNT_,
990028\DICMETAF.FUNC_BODY.18=                     ISNUM, NUM_REG, NOM_VAL, ORG_REG, ISSUENUM, TYPE_, STATUS, PMFU,
990028\DICMETAF.FUNC_BODY.19=                     IS_MCS, IS_MARGIN, NOM_TYPE, REP_DATE,
990028\DICMETAF.FUNC_BODY.20=                     (select VALUE_ID from OD_PR_BASE_ID) as BASE_CURR
990028\DICMETAF.FUNC_BODY.21=                     from OD_SHARES
990028\DICMETAF.FUNC_BODY.22=                     where ID = :ID]
990028\DICMETAF.FUNC_BODY.23=from %id
990028\DICMETAF.FUNC_BODY.24=into MNEM, BIRTHDATE, DEATHDATE, DATE_REG, MODE, NOMINAL, COUNT_, ISNUM, NUM_REG,
990028\DICMETAF.FUNC_BODY.25=     NOM_VAL, ORG_REG, ISSUENUM, TYPE_, STATUS, PMFU, IS_MCS, IS_MARGIN, NOM_TYPE,
990028\DICMETAF.FUNC_BODY.26=     REP_DATE, BASE_CURR
990028\DICMETAF.FUNC_BODY.27=do
990028\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_s(%lines, %ind, 'MNEM', MNEM);
990028\DICMETAF.FUNC_BODY.29=    _F_ENVLIGHT->put_d(%lines, %ind, 'BIRTHDATE', BIRTHDATE);
990028\DICMETAF.FUNC_BODY.30=    _F_ENVLIGHT->put_d(%lines, %ind, 'DEATHDATE', DEATHDATE);
990028\DICMETAF.FUNC_BODY.31=    _F_ENVLIGHT->put_d(%lines, %ind, 'DATE_REG', DATE_REG);
990028\DICMETAF.FUNC_BODY.32=    _F_ENVLIGHT->put_n(%lines, %ind, 'MODE', MODE);
990028\DICMETAF.FUNC_BODY.33=    _F_ENVLIGHT->put_n(%lines, %ind, 'NOMINAL', NOMINAL);
990028\DICMETAF.FUNC_BODY.34=    _F_ENVLIGHT->put_n(%lines, %ind, 'COUNT_', COUNT_);
990028\DICMETAF.FUNC_BODY.35=    _F_ENVLIGHT->put_s(%lines, %ind, 'ISNUM', ISNUM);
990028\DICMETAF.FUNC_BODY.36=    _F_ENVLIGHT->put_s(%lines, %ind, 'NUM_REG', NUM_REG);
990028\DICMETAF.FUNC_BODY.37=    if ~IsBlank(NOM_VAL) then
990028\DICMETAF.FUNC_BODY.38=        if NOM_VAL <> BASE_CURR then
990028\DICMETAF.FUNC_BODY.39=            _F_ENVLIGHT->put_n(%lines, %ind, 'NOM_VAL', NOM_VAL);
990028\DICMETAF.FUNC_BODY.40=        end;
990028\DICMETAF.FUNC_BODY.41=    end;
990028\DICMETAF.FUNC_BODY.42=    _F_ENVLIGHT->put_f(%lines, %ind, 'ORG_REG', %seen, ORG_REG);
990028\DICMETAF.FUNC_BODY.43=    _F_ENVLIGHT->put_n(%lines, %ind, 'ISSUENUM', ISSUENUM);
990028\DICMETAF.FUNC_BODY.44=    _F_ENVLIGHT->put_z(%lines, %ind, 'TYPE_', TYPE_);
990028\DICMETAF.FUNC_BODY.45=    _F_ENVLIGHT->put_n(%lines, %ind, 'STATUS', STATUS);
990028\DICMETAF.FUNC_BODY.46=    _F_ENVLIGHT->put_n(%lines, %ind, 'PMFU', PMFU);
990028\DICMETAF.FUNC_BODY.47=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_MCS', IS_MCS);
990028\DICMETAF.FUNC_BODY.48=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_MARGIN', IS_MARGIN);
990028\DICMETAF.FUNC_BODY.49=    _F_ENVLIGHT->put_z(%lines, %ind, 'NOM_TYPE', NOM_TYPE);
990028\DICMETAF.FUNC_BODY.50=    _F_ENVLIGHT->put_d(%lines, %ind, 'REP_DATE', REP_DATE);
990028\DICMETAF.FUNC_BODY.51=end
990028\DICMETAF.FUNC_BODY.COUNT=52
990028\DICMETAF.FUNC_HEADER.0=out_share_main( %lines:LargeInt; %ind:Str; %seen:LargeInt;
990028\DICMETAF.FUNC_HEADER.1=   %id:Int )
990028\DICMETAF.FUNC_HEADER.COUNT=2
990028\DICMETAF.FUNC_ID=out_share_main
990028\DICMETAF.IS_CANON=0
990028\DICMETAF.IS_USER=1
990028\DICMETAF.MD5_HASH=5f0c620dfd6678b37134926c7d4d69e4
990028\DICMETAF.MD5_STAMP=01.11.2026
990029\DICMETAF.FORM_NUM=990000
990029\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990029\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_o( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990029\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990029\DICMETAF.FUNC_BODY.03=   Поля облигации/банковского сертификата из OD_O_SHARES. GUARANTOR и
990029\DICMETAF.FUNC_BODY.04=   IMMO_COVER - ссылки на лица (<<&алиас>>).
990029\DICMETAF.FUNC_BODY.06=   Параметры: %lines, %ind, %seen - как выше; %id - OD_SHARES.ID версии.
990029\DICMETAF.FUNC_BODY.07=   ----------------------------------------------------------------------------- */
990029\DICMETAF.FUNC_BODY.08=var IS_SAVE, IS_CONV, PERIOD, DAYS, PERCENT_, PRICE, STAVKA, PERIOD_M, IS_GG, NKD_MFU,
990029\DICMETAF.FUNC_BODY.09=    P_MODEL, IS_EUR_BOND, IS_CLEAR, IS_JUNIOR, IS_SERT, NKD_RT, GUARANTOR, IMMO_COVER,
990029\DICMETAF.FUNC_BODY.10=    DOC_DAT, DOC_NUM, D_NOMIN, D_OWNER, DEBTOR, MORTGAGER, SN_IS_OFFER, SN_A_CLASS,
990029\DICMETAF.FUNC_BODY.11=    SN_CP_PRC, SN_MIN_DX_PRC, SN_MAX_DX_PRC;
990029\DICMETAF.FUNC_BODY.12=for 'Данные' select [select IS_SAVE, IS_CONV, PERIOD, DAYS, PERCENT_, PRICE, STAVKA,
990029\DICMETAF.FUNC_BODY.13=                     PERIOD_M, IS_GG, NKD_MFU, P_MODEL, IS_EUR_BOND, IS_CLEAR,
990029\DICMETAF.FUNC_BODY.14=                     IS_JUNIOR, IS_SERT, NKD_RT, GUARANTOR, IMMO_COVER, DOC_DAT,
990029\DICMETAF.FUNC_BODY.15=                     DOC_NUM, D_NOMIN, D_OWNER, DEBTOR, MORTGAGER, SN_IS_OFFER,
990029\DICMETAF.FUNC_BODY.16=                     SN_A_CLASS, SN_CP_PRC, SN_MIN_DX_PRC, SN_MAX_DX_PRC
990029\DICMETAF.FUNC_BODY.17=                     from OD_O_SHARES
990029\DICMETAF.FUNC_BODY.18=                     where SHARE = :SHARE]
990029\DICMETAF.FUNC_BODY.19=from %id
990029\DICMETAF.FUNC_BODY.20=into IS_SAVE, IS_CONV, PERIOD, DAYS, PERCENT_, PRICE, STAVKA, PERIOD_M, IS_GG, NKD_MFU,
990029\DICMETAF.FUNC_BODY.21=     P_MODEL, IS_EUR_BOND, IS_CLEAR, IS_JUNIOR, IS_SERT, NKD_RT, GUARANTOR, IMMO_COVER,
990029\DICMETAF.FUNC_BODY.22=     DOC_DAT, DOC_NUM, D_NOMIN, D_OWNER, DEBTOR, MORTGAGER, SN_IS_OFFER, SN_A_CLASS,
990029\DICMETAF.FUNC_BODY.23=     SN_CP_PRC, SN_MIN_DX_PRC, SN_MAX_DX_PRC
990029\DICMETAF.FUNC_BODY.24=do
990029\DICMETAF.FUNC_BODY.25=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_SAVE', IS_SAVE);
990029\DICMETAF.FUNC_BODY.26=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_CONV', IS_CONV);
990029\DICMETAF.FUNC_BODY.27=    _F_ENVLIGHT->put_n(%lines, %ind, 'PERIOD', PERIOD);
990029\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_n(%lines, %ind, 'DAYS', DAYS);
990029\DICMETAF.FUNC_BODY.29=    _F_ENVLIGHT->put_n(%lines, %ind, 'PERCENT_', PERCENT_);
990029\DICMETAF.FUNC_BODY.30=    _F_ENVLIGHT->put_n(%lines, %ind, 'PRICE', PRICE);
990029\DICMETAF.FUNC_BODY.31=    _F_ENVLIGHT->put_n(%lines, %ind, 'STAVKA', STAVKA);
990029\DICMETAF.FUNC_BODY.32=    _F_ENVLIGHT->put_n(%lines, %ind, 'PERIOD_M', PERIOD_M);
990029\DICMETAF.FUNC_BODY.33=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_GG', IS_GG);
990029\DICMETAF.FUNC_BODY.34=    _F_ENVLIGHT->put_n(%lines, %ind, 'NKD_MFU', NKD_MFU);
990029\DICMETAF.FUNC_BODY.35=    _F_ENVLIGHT->put_n(%lines, %ind, 'P_MODEL', P_MODEL);
990029\DICMETAF.FUNC_BODY.36=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_EUR_BOND', IS_EUR_BOND);
990029\DICMETAF.FUNC_BODY.37=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_CLEAR', IS_CLEAR);
990029\DICMETAF.FUNC_BODY.38=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_JUNIOR', IS_JUNIOR);
990029\DICMETAF.FUNC_BODY.39=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_SERT', IS_SERT);
990029\DICMETAF.FUNC_BODY.40=    _F_ENVLIGHT->put_n(%lines, %ind, 'NKD_RT', NKD_RT);
990029\DICMETAF.FUNC_BODY.41=    _F_ENVLIGHT->put_f(%lines, %ind, 'GUARANTOR', %seen, GUARANTOR);
990029\DICMETAF.FUNC_BODY.42=    _F_ENVLIGHT->put_f(%lines, %ind, 'IMMO_COVER', %seen, IMMO_COVER);
990029\DICMETAF.FUNC_BODY.43=    _F_ENVLIGHT->put_d(%lines, %ind, 'DOC_DAT', DOC_DAT);
990029\DICMETAF.FUNC_BODY.44=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOC_NUM', DOC_NUM);
990029\DICMETAF.FUNC_BODY.45=    _F_ENVLIGHT->put_s(%lines, %ind, 'D_NOMIN', D_NOMIN);
990029\DICMETAF.FUNC_BODY.46=    _F_ENVLIGHT->put_s(%lines, %ind, 'D_OWNER', D_OWNER);
990029\DICMETAF.FUNC_BODY.47=    _F_ENVLIGHT->put_s(%lines, %ind, 'DEBTOR', DEBTOR);
990029\DICMETAF.FUNC_BODY.48=    _F_ENVLIGHT->put_s(%lines, %ind, 'MORTGAGER', MORTGAGER);
990029\DICMETAF.FUNC_BODY.49=    _F_ENVLIGHT->put_n(%lines, %ind, 'SN_IS_OFFER', SN_IS_OFFER);
990029\DICMETAF.FUNC_BODY.50=    _F_ENVLIGHT->put_n(%lines, %ind, 'SN_A_CLASS', SN_A_CLASS);
990029\DICMETAF.FUNC_BODY.51=    _F_ENVLIGHT->put_n(%lines, %ind, 'SN_CP_PRC', SN_CP_PRC);
990029\DICMETAF.FUNC_BODY.52=    _F_ENVLIGHT->put_n(%lines, %ind, 'SN_MIN_DX_PRC', SN_MIN_DX_PRC);
990029\DICMETAF.FUNC_BODY.53=    _F_ENVLIGHT->put_n(%lines, %ind, 'SN_MAX_DX_PRC', SN_MAX_DX_PRC);
990029\DICMETAF.FUNC_BODY.54=end
990029\DICMETAF.FUNC_BODY.COUNT=55
990029\DICMETAF.FUNC_HEADER.0=out_share_o( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990029\DICMETAF.FUNC_HEADER.COUNT=1
990029\DICMETAF.FUNC_ID=out_share_o
990029\DICMETAF.IS_CANON=0
990029\DICMETAF.IS_USER=1
990029\DICMETAF.MD5_HASH=b0456d7e56dc056f3f6599195772c4dc
990029\DICMETAF.MD5_STAMP=01.11.2026
990030\DICMETAF.FORM_NUM=990000
990030\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990030\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_opts( %lines:LargeInt; %ind:Str; %share_id:Int;
990030\DICMETAF.FUNC_BODY.02=      %b_date:Date )
990030\DICMETAF.FUNC_BODY.03=   -----------------------------------------------------------------------------
990030\DICMETAF.FUNC_BODY.04=   Исторические поля инструмента NAME, ISIN, CFI на дату начала версии:
990030\DICMETAF.FUNC_BODY.05=   значение берётся из исторических опций (OD_OPTIONS), а при их отсутствии -
990030\DICMETAF.FUNC_BODY.06=   из OD_VALUES (то же правило, что в API_UPD_SHARE).
990030\DICMETAF.FUNC_BODY.08=   Параметры:
990030\DICMETAF.FUNC_BODY.09=     %lines, %ind - как выше; %share_id - OD_VALUES.ID (SELF_ID);
990030\DICMETAF.FUNC_BODY.10=     %b_date - дата начала версии (OD_SHARES.B_DATE).
990030\DICMETAF.FUNC_BODY.11=   ----------------------------------------------------------------------------- */
990030\DICMETAF.FUNC_BODY.12=var v_name, v_isin, v_cfi;
990030\DICMETAF.FUNC_BODY.13=v_name := Extract('Данные', [select coalesce(O.VAL, V.NAME)
990030\DICMETAF.FUNC_BODY.14=                       from OD_VALUES V
990030\DICMETAF.FUNC_BODY.15=                            left join OD_DOC_CATS C on C.SYS_NAME = 'OD_SHARES'
990030\DICMETAF.FUNC_BODY.16=                            left join OP_FIELDS F on F.OP = C.ID and F.AS_NAME = 'S_NAME'
990030\DICMETAF.FUNC_BODY.17=                            left join OD_OPTIONS O on O.OBJECT = V.ID and O.DESCR = F.ID
990030\DICMETAF.FUNC_BODY.18=                                                  and O.B_DATE <= :B_DATE and O.E_DATE > :E_DATE
990030\DICMETAF.FUNC_BODY.19=                       where V.ID = :ID],
990030\DICMETAF.FUNC_BODY.20=                  %b_date, %b_date, %share_id);
990030\DICMETAF.FUNC_BODY.21=v_isin := Extract('Данные', [select coalesce(O.VAL, V.ISIN)
990030\DICMETAF.FUNC_BODY.22=                       from OD_VALUES V
990030\DICMETAF.FUNC_BODY.23=                            left join OD_DOC_CATS C on C.SYS_NAME = 'OD_SHARES'
990030\DICMETAF.FUNC_BODY.24=                            left join OP_FIELDS F on F.OP = C.ID and F.AS_NAME = 'ISIN'
990030\DICMETAF.FUNC_BODY.25=                            left join OD_OPTIONS O on O.OBJECT = V.ID and O.DESCR = F.ID
990030\DICMETAF.FUNC_BODY.26=                                                  and O.B_DATE <= :B_DATE and O.E_DATE > :E_DATE
990030\DICMETAF.FUNC_BODY.27=                       where V.ID = :ID],
990030\DICMETAF.FUNC_BODY.28=                  %b_date, %b_date, %share_id);
990030\DICMETAF.FUNC_BODY.29=v_cfi := Extract('Данные', [select coalesce(O.VAL, V.CFI)
990030\DICMETAF.FUNC_BODY.30=                       from OD_VALUES V
990030\DICMETAF.FUNC_BODY.31=                            left join OD_DOC_CATS C on C.SYS_NAME = 'OD_SHARES'
990030\DICMETAF.FUNC_BODY.32=                            left join OP_FIELDS F on F.OP = C.ID and F.AS_NAME = 'CFI'
990030\DICMETAF.FUNC_BODY.33=                            left join OD_OPTIONS O on O.OBJECT = V.ID and O.DESCR = F.ID
990030\DICMETAF.FUNC_BODY.34=                                                  and O.B_DATE <= :B_DATE and O.E_DATE > :E_DATE
990030\DICMETAF.FUNC_BODY.35=                       where V.ID = :ID],
990030\DICMETAF.FUNC_BODY.36=                 %b_date, %b_date, %share_id);
990030\DICMETAF.FUNC_BODY.37=_F_ENVLIGHT->put_s(%lines, %ind, 'NAME', v_name);
990030\DICMETAF.FUNC_BODY.38=_F_ENVLIGHT->put_s(%lines, %ind, 'ISIN', v_isin);
990030\DICMETAF.FUNC_BODY.39=_F_ENVLIGHT->put_s(%lines, %ind, 'CFI', v_cfi)
990030\DICMETAF.FUNC_BODY.COUNT=40
990030\DICMETAF.FUNC_HEADER.0=out_share_opts( %lines:LargeInt; %ind:Str; %share_id:Int;
990030\DICMETAF.FUNC_HEADER.1=   %b_date:Date )
990030\DICMETAF.FUNC_HEADER.COUNT=2
990030\DICMETAF.FUNC_ID=out_share_opts
990030\DICMETAF.IS_CANON=0
990030\DICMETAF.IS_USER=1
990030\DICMETAF.MD5_HASH=5f04908e0541a94118c0ff5636ff1413
990030\DICMETAF.MD5_STAMP=01.11.2026
990031\DICMETAF.FORM_NUM=990000
990031\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990031\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_t( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990031\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990031\DICMETAF.FUNC_BODY.03=   Поля производного инструмента (опцион, фьючерс, депозитарная расписка)
990031\DICMETAF.FUNC_BODY.04=   из OD_T_SHARES. BANK - ссылка на лицо (<<&алиас>>). Коды валют VALUTA и
990031\DICMETAF.FUNC_BODY.05=   STEP_VAL выводятся числом, только если не равны базовой валюте базы.
990031\DICMETAF.FUNC_BODY.07=   Параметры: %lines, %ind, %seen - как выше; %id - OD_SHARES.ID версии.
990031\DICMETAF.FUNC_BODY.08=   ----------------------------------------------------------------------------- */
990031\DICMETAF.FUNC_BODY.09=var AMOUNT, PRICE, VALUTA, IS_VARGIN, IS_CLEAR, BANK, STEP_VAL, STEP_MIN, STEP_PRICE,
990031\DICMETAF.FUNC_BODY.10=    STRIKE1, STRIKE2, KU, KZK, STYLE, BASE_CURR;
990031\DICMETAF.FUNC_BODY.11=for 'Данные' select [select AMOUNT, PRICE, VALUTA, IS_VARGIN, IS_CLEAR, BANK, STEP_VAL,
990031\DICMETAF.FUNC_BODY.12=                     STEP_MIN, STEP_PRICE, STRIKE1, STRIKE2, KU, KZK, STYLE,
990031\DICMETAF.FUNC_BODY.13=                     (select VALUE_ID from OD_PR_BASE_ID) as BASE_CURR
990031\DICMETAF.FUNC_BODY.14=                     from OD_T_SHARES
990031\DICMETAF.FUNC_BODY.15=                     where SHARE = :SHARE]
990031\DICMETAF.FUNC_BODY.16=from %id
990031\DICMETAF.FUNC_BODY.17=into AMOUNT, PRICE, VALUTA, IS_VARGIN, IS_CLEAR, BANK, STEP_VAL, STEP_MIN, STEP_PRICE,
990031\DICMETAF.FUNC_BODY.18=     STRIKE1, STRIKE2, KU, KZK, STYLE, BASE_CURR
990031\DICMETAF.FUNC_BODY.19=do
990031\DICMETAF.FUNC_BODY.20=    _F_ENVLIGHT->put_n(%lines, %ind, 'AMOUNT', AMOUNT);
990031\DICMETAF.FUNC_BODY.21=    _F_ENVLIGHT->put_n(%lines, %ind, 'PRICE', PRICE);
990031\DICMETAF.FUNC_BODY.22=    if ~IsBlank(VALUTA) then
990031\DICMETAF.FUNC_BODY.23=        if VALUTA <> BASE_CURR then
990031\DICMETAF.FUNC_BODY.24=            _F_ENVLIGHT->put_n(%lines, %ind, 'VALUTA', VALUTA);
990031\DICMETAF.FUNC_BODY.25=        end;
990031\DICMETAF.FUNC_BODY.26=    end;
990031\DICMETAF.FUNC_BODY.27=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_VARGIN', IS_VARGIN);
990031\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_CLEAR', IS_CLEAR);
990031\DICMETAF.FUNC_BODY.29=    _F_ENVLIGHT->put_f(%lines, %ind, 'BANK', %seen, BANK);
990031\DICMETAF.FUNC_BODY.30=    if ~IsBlank(STEP_VAL) then
990031\DICMETAF.FUNC_BODY.31=        if STEP_VAL <> BASE_CURR then
990031\DICMETAF.FUNC_BODY.32=            _F_ENVLIGHT->put_n(%lines, %ind, 'STEP_VAL', STEP_VAL);
990031\DICMETAF.FUNC_BODY.33=        end;
990031\DICMETAF.FUNC_BODY.34=    end;
990031\DICMETAF.FUNC_BODY.35=    _F_ENVLIGHT->put_n(%lines, %ind, 'STEP_MIN', STEP_MIN);
990031\DICMETAF.FUNC_BODY.36=    _F_ENVLIGHT->put_n(%lines, %ind, 'STEP_PRICE', STEP_PRICE);
990031\DICMETAF.FUNC_BODY.37=    _F_ENVLIGHT->put_n(%lines, %ind, 'STRIKE1', STRIKE1);
990031\DICMETAF.FUNC_BODY.38=    _F_ENVLIGHT->put_n(%lines, %ind, 'STRIKE2', STRIKE2);
990031\DICMETAF.FUNC_BODY.39=    _F_ENVLIGHT->put_n(%lines, %ind, 'KU', KU);
990031\DICMETAF.FUNC_BODY.40=    _F_ENVLIGHT->put_n(%lines, %ind, 'KZK', KZK);
990031\DICMETAF.FUNC_BODY.41=    _F_ENVLIGHT->put_n(%lines, %ind, 'STYLE', STYLE);
990031\DICMETAF.FUNC_BODY.42=end
990031\DICMETAF.FUNC_BODY.COUNT=43
990031\DICMETAF.FUNC_HEADER.0=out_share_t( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990031\DICMETAF.FUNC_HEADER.COUNT=1
990031\DICMETAF.FUNC_ID=out_share_t
990031\DICMETAF.IS_CANON=0
990031\DICMETAF.IS_USER=1
990031\DICMETAF.MD5_HASH=ce53f04cb12241368fd739641c76b6d2
990031\DICMETAF.MD5_STAMP=01.11.2026
990032\DICMETAF.FORM_NUM=990000
990032\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990032\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_v( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990032\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990032\DICMETAF.FUNC_BODY.03=   Поля векселя из OD_V_SHARES. TRASSANT, REMITENT, TRASSAT, AVELIST - ссылки
990032\DICMETAF.FUNC_BODY.04=   на лица (<<&алиас>>).
990032\DICMETAF.FUNC_BODY.06=   Параметры: %lines, %ind, %seen - как выше; %id - OD_SHARES.ID версии.
990032\DICMETAF.FUNC_BODY.07=   ----------------------------------------------------------------------------- */
990032\DICMETAF.FUNC_BODY.08=var IS_ACCEPT, IS_PASS, TRASSANT, REMITENT, TRASSAT, AVELIST, BIRTHPLACE, DEATHPLACE,
990032\DICMETAF.FUNC_BODY.09=    PERCENT_, P_DATE, P_END, STOP_DATE, IN_NOM_VAL;
990032\DICMETAF.FUNC_BODY.10=for 'Данные' select [select IS_ACCEPT, IS_PASS, TRASSANT, REMITENT, TRASSAT, AVELIST,
990032\DICMETAF.FUNC_BODY.11=                     BIRTHPLACE, DEATHPLACE, PERCENT_, P_DATE, P_END, STOP_DATE,
990032\DICMETAF.FUNC_BODY.12=                     IN_NOM_VAL
990032\DICMETAF.FUNC_BODY.13=                     from OD_V_SHARES
990032\DICMETAF.FUNC_BODY.14=                     where SHARE = :SHARE]
990032\DICMETAF.FUNC_BODY.15=from %id
990032\DICMETAF.FUNC_BODY.16=into IS_ACCEPT, IS_PASS, TRASSANT, REMITENT, TRASSAT, AVELIST, BIRTHPLACE, DEATHPLACE,
990032\DICMETAF.FUNC_BODY.17=     PERCENT_, P_DATE, P_END, STOP_DATE, IN_NOM_VAL
990032\DICMETAF.FUNC_BODY.18=do
990032\DICMETAF.FUNC_BODY.19=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_ACCEPT', IS_ACCEPT);
990032\DICMETAF.FUNC_BODY.20=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_PASS', IS_PASS);
990032\DICMETAF.FUNC_BODY.21=    _F_ENVLIGHT->put_f(%lines, %ind, 'TRASSANT', %seen, TRASSANT);
990032\DICMETAF.FUNC_BODY.22=    _F_ENVLIGHT->put_f(%lines, %ind, 'REMITENT', %seen, REMITENT);
990032\DICMETAF.FUNC_BODY.23=    _F_ENVLIGHT->put_f(%lines, %ind, 'TRASSAT', %seen, TRASSAT);
990032\DICMETAF.FUNC_BODY.24=    _F_ENVLIGHT->put_f(%lines, %ind, 'AVELIST', %seen, AVELIST);
990032\DICMETAF.FUNC_BODY.25=    _F_ENVLIGHT->put_s(%lines, %ind, 'BIRTHPLACE', BIRTHPLACE);
990032\DICMETAF.FUNC_BODY.26=    _F_ENVLIGHT->put_s(%lines, %ind, 'DEATHPLACE', DEATHPLACE);
990032\DICMETAF.FUNC_BODY.27=    _F_ENVLIGHT->put_z(%lines, %ind, 'PERCENT_', PERCENT_);
990032\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_d(%lines, %ind, 'P_DATE', P_DATE);
990032\DICMETAF.FUNC_BODY.29=    _F_ENVLIGHT->put_d(%lines, %ind, 'P_END', P_END);
990032\DICMETAF.FUNC_BODY.30=    _F_ENVLIGHT->put_d(%lines, %ind, 'STOP_DATE', STOP_DATE);
990032\DICMETAF.FUNC_BODY.31=    _F_ENVLIGHT->put_n(%lines, %ind, 'IN_NOM_VAL', IN_NOM_VAL);
990032\DICMETAF.FUNC_BODY.32=end
990032\DICMETAF.FUNC_BODY.COUNT=33
990032\DICMETAF.FUNC_HEADER.0=out_share_v( %lines:LargeInt; %ind:Str; %seen:LargeInt; %id:Int )
990032\DICMETAF.FUNC_HEADER.COUNT=1
990032\DICMETAF.FUNC_ID=out_share_v
990032\DICMETAF.IS_CANON=0
990032\DICMETAF.IS_USER=1
990032\DICMETAF.MD5_HASH=07538d666f03c0f42f4e542e2850ddfb
990032\DICMETAF.MD5_STAMP=01.11.2026
990033\DICMETAF.FORM_NUM=990000
990033\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990033\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_share_values( %lines:LargeInt; %ind:Str; %share_id:Int )
990033\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990033\DICMETAF.FUNC_BODY.03=   Поля инструмента из OD_VALUES, не зависящие от версии: SYSNAME, MFU, IS_IN.
990033\DICMETAF.FUNC_BODY.04=   Выводятся один раз, в первом блоке.
990033\DICMETAF.FUNC_BODY.06=   Параметры: %lines, %ind - как выше; %share_id - OD_VALUES.ID (SELF_ID).
990033\DICMETAF.FUNC_BODY.07=   ----------------------------------------------------------------------------- */
990033\DICMETAF.FUNC_BODY.08=var SYSNAME, MFU, IS_IN;
990033\DICMETAF.FUNC_BODY.09=for 'Данные' select [select SYSNAME, MFU, IS_IN
990033\DICMETAF.FUNC_BODY.10=                     from OD_VALUES
990033\DICMETAF.FUNC_BODY.11=                     where ID = :ID]
990033\DICMETAF.FUNC_BODY.12=from %share_id
990033\DICMETAF.FUNC_BODY.13=into SYSNAME, MFU, IS_IN
990033\DICMETAF.FUNC_BODY.14=do
990033\DICMETAF.FUNC_BODY.15=    _F_ENVLIGHT->put_s(%lines, %ind, 'SYSNAME', SYSNAME);
990033\DICMETAF.FUNC_BODY.16=    _F_ENVLIGHT->put_z(%lines, %ind, 'MFU', MFU);
990033\DICMETAF.FUNC_BODY.17=    _F_ENVLIGHT->put_n(%lines, %ind, 'IS_IN', IS_IN);
990033\DICMETAF.FUNC_BODY.18=end
990033\DICMETAF.FUNC_BODY.COUNT=19
990033\DICMETAF.FUNC_HEADER.0=out_share_values( %lines:LargeInt; %ind:Str; %share_id:Int )
990033\DICMETAF.FUNC_HEADER.COUNT=1
990033\DICMETAF.FUNC_ID=out_share_values
990033\DICMETAF.IS_CANON=0
990033\DICMETAF.IS_USER=1
990033\DICMETAF.MD5_HASH=ac87d09728499fabe3464d56b09c3ada
990033\DICMETAF.MD5_STAMP=01.11.2026
990034\DICMETAF.FORM_NUM=990000
990034\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990034\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_a( %lines:LargeInt; %ind:Str; %name:Str; %seen:LargeInt;
990034\DICMETAF.FUNC_BODY.02=      %value )
990034\DICMETAF.FUNC_BODY.03=   -----------------------------------------------------------------------------
990034\DICMETAF.FUNC_BODY.04=   Добавить поле-ссылку на банковский счёт <<ИМЯ=&алиас>>; если счёт не
990034\DICMETAF.FUNC_BODY.05=   выгружен выше, вместо поля пишется комментарий.
990034\DICMETAF.FUNC_BODY.07=   Параметры:
990034\DICMETAF.FUNC_BODY.08=     %lines, %ind, %name - как у put_s;
990034\DICMETAF.FUNC_BODY.09=     %seen  - дескриптор списка выгруженных объектов (ключи A<ID счёта>);
990034\DICMETAF.FUNC_BODY.10=     %value - ID счёта (OD_FACE_ACCS.ID).
990034\DICMETAF.FUNC_BODY.11=   ----------------------------------------------------------------------------- */
990034\DICMETAF.FUNC_BODY.12=var v_id;
990034\DICMETAF.FUNC_BODY.13=if ~IsBlank(%value) then
990034\DICMETAF.FUNC_BODY.14=    v_id := Trim(Str(%value));
990034\DICMETAF.FUNC_BODY.15=    if _F_ENVLIGHT->has(%seen, 'A' + v_id) = 1 then
990034\DICMETAF.FUNC_BODY.16=        ListAdd(%lines, %ind + %name + '=&a' + v_id);
990034\DICMETAF.FUNC_BODY.17=    else
990034\DICMETAF.FUNC_BODY.18=        ListAdd(%lines, %ind + '# ' + %name + ': счёт ID=' + v_id + ' не выгружен');
990034\DICMETAF.FUNC_BODY.19=    end;
990034\DICMETAF.FUNC_BODY.20=end
990034\DICMETAF.FUNC_BODY.COUNT=21
990034\DICMETAF.FUNC_HEADER.0=put_a( %lines:LargeInt; %ind:Str; %name:Str; %seen:LargeInt;
990034\DICMETAF.FUNC_HEADER.1=   %value )
990034\DICMETAF.FUNC_HEADER.COUNT=2
990034\DICMETAF.FUNC_ID=put_a
990034\DICMETAF.IS_CANON=0
990034\DICMETAF.IS_USER=1
990034\DICMETAF.MD5_HASH=a7c1d97493c60e0c10e2c7eabaa4702c
990034\DICMETAF.MD5_STAMP=01.11.2026
990035\DICMETAF.FORM_NUM=990000
990035\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990035\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_d( %lines:LargeInt; %ind:Str; %name:Str; %value )
990035\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990035\DICMETAF.FUNC_BODY.03=   Добавить поле-дату <<ИМЯ=ДД.ММ.ГГГГ>>. Пустая дата и служебные границы
990035\DICMETAF.FUNC_BODY.04=   (01.01.1900 - начало времён, 01.01.9999 - бесконечность) пропускаются:
990035\DICMETAF.FUNC_BODY.05=   это значения по умолчанию, в сценарии они не нужны.
990035\DICMETAF.FUNC_BODY.07=   Параметры: как у put_s; %value - дата или дата-время.
990035\DICMETAF.FUNC_BODY.08=   ----------------------------------------------------------------------------- */
990035\DICMETAF.FUNC_BODY.09=if ~IsBlank(%value) then
990035\DICMETAF.FUNC_BODY.10=    if (Year(%value) > 1900) and (Year(%value) < 9999) then
990035\DICMETAF.FUNC_BODY.11=        ListAdd(%lines, %ind + %name + '=' + _F_ENVLIGHT->fmt_date(%value));
990035\DICMETAF.FUNC_BODY.12=    end;
990035\DICMETAF.FUNC_BODY.13=end
990035\DICMETAF.FUNC_BODY.COUNT=14
990035\DICMETAF.FUNC_HEADER.0=put_d( %lines:LargeInt; %ind:Str; %name:Str; %value )
990035\DICMETAF.FUNC_HEADER.COUNT=1
990035\DICMETAF.FUNC_ID=put_d
990035\DICMETAF.IS_CANON=0
990035\DICMETAF.IS_USER=1
990035\DICMETAF.MD5_HASH=48e738ea1158bc8f573be6b7a5881bd1
990035\DICMETAF.MD5_STAMP=01.11.2026
990036\DICMETAF.FORM_NUM=990000
990036\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990036\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_f( %lines:LargeInt; %ind:Str; %name:Str; %seen:LargeInt;
990036\DICMETAF.FUNC_BODY.02=      %value )
990036\DICMETAF.FUNC_BODY.03=   -----------------------------------------------------------------------------
990036\DICMETAF.FUNC_BODY.04=   Добавить поле-ссылку на лицо <<ИМЯ=&алиас>>. Значение приводится к SELF_ID
990036\DICMETAF.FUNC_BODY.05=   лица (хранимые ссылки бывают и на ID версии). Если лицо ещё не выгружено выше
990036\DICMETAF.FUNC_BODY.06=   (цикл ссылок или ссылка на само лицо), вместо поля пишется комментарий.
990036\DICMETAF.FUNC_BODY.08=   Параметры:
990036\DICMETAF.FUNC_BODY.09=     %lines, %ind, %name - как у put_s;
990036\DICMETAF.FUNC_BODY.10=     %seen  - дескриптор списка уже выгруженных объектов (ключи F<SELF_ID>);
990036\DICMETAF.FUNC_BODY.11=     %value - ID лица (OD_FACES.ID или SELF_ID).
990036\DICMETAF.FUNC_BODY.12=   ----------------------------------------------------------------------------- */
990036\DICMETAF.FUNC_BODY.13=var v_self, v_id;
990036\DICMETAF.FUNC_BODY.14=if ~IsBlank(%value) then
990036\DICMETAF.FUNC_BODY.15=    v_self := _F_ENVLIGHT->ref_self(%value);
990036\DICMETAF.FUNC_BODY.16=    if IsBlank(v_self) then
990036\DICMETAF.FUNC_BODY.17=        ListAdd(%lines, %ind + '# ' + %name + ': лицо ID=' + Trim(Str(%value)) + ' не найдено в базе');
990036\DICMETAF.FUNC_BODY.18=    else
990036\DICMETAF.FUNC_BODY.19=        v_id := Trim(Str(v_self));
990036\DICMETAF.FUNC_BODY.20=        if _F_ENVLIGHT->has(%seen, 'F' + v_id) = 1 then
990036\DICMETAF.FUNC_BODY.21=            ListAdd(%lines, %ind + %name + '=&f' + v_id);
990036\DICMETAF.FUNC_BODY.22=        else
990036\DICMETAF.FUNC_BODY.23=            ListAdd(%lines, %ind + '# ' + %name + ': лицо SELF_ID=' + v_id + ' не выгружено выше (цикл ссылок)');
990036\DICMETAF.FUNC_BODY.24=        end;
990036\DICMETAF.FUNC_BODY.25=    end;
990036\DICMETAF.FUNC_BODY.26=end
990036\DICMETAF.FUNC_BODY.COUNT=27
990036\DICMETAF.FUNC_HEADER.0=put_f( %lines:LargeInt; %ind:Str; %name:Str; %seen:LargeInt;
990036\DICMETAF.FUNC_HEADER.1=   %value )
990036\DICMETAF.FUNC_HEADER.COUNT=2
990036\DICMETAF.FUNC_ID=put_f
990036\DICMETAF.IS_CANON=0
990036\DICMETAF.IS_USER=1
990036\DICMETAF.MD5_HASH=82711553c23da73fb79dc482b4e644ac
990036\DICMETAF.MD5_STAMP=01.11.2026
990037\DICMETAF.FORM_NUM=990000
990037\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990037\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_n( %lines:LargeInt; %ind:Str; %name:Str; %value )
990037\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990037\DICMETAF.FUNC_BODY.03=   Добавить числовое поле <<ИМЯ=число>>; пустое значение (NULL) пропускается.
990037\DICMETAF.FUNC_BODY.05=   Параметры: как у put_s; %value - число (целое или дробное).
990037\DICMETAF.FUNC_BODY.06=   ----------------------------------------------------------------------------- */
990037\DICMETAF.FUNC_BODY.07=if ~IsBlank(%value) then
990037\DICMETAF.FUNC_BODY.08=    ListAdd(%lines, %ind + %name + '=' + Trim(Str(%value)));
990037\DICMETAF.FUNC_BODY.09=end
990037\DICMETAF.FUNC_BODY.COUNT=10
990037\DICMETAF.FUNC_HEADER.0=put_n( %lines:LargeInt; %ind:Str; %name:Str; %value )
990037\DICMETAF.FUNC_HEADER.COUNT=1
990037\DICMETAF.FUNC_ID=put_n
990037\DICMETAF.IS_CANON=0
990037\DICMETAF.IS_USER=1
990037\DICMETAF.MD5_HASH=10996597eceb7e712d32d8c2b9eafaa9
990037\DICMETAF.MD5_STAMP=01.11.2026
990038\DICMETAF.FORM_NUM=990000
990038\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990038\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_s( %lines:LargeInt; %ind:Str; %name:Str; %value )
990038\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990038\DICMETAF.FUNC_BODY.03=   Добавить строку <<ИМЯ=значение>> в выгрузку; пустое значение пропускается.
990038\DICMETAF.FUNC_BODY.05=   Параметры:
990038\DICMETAF.FUNC_BODY.06=     %lines - дескриптор списка строк выгрузки (L.self);
990038\DICMETAF.FUNC_BODY.07=     %ind   - отступ строки;
990038\DICMETAF.FUNC_BODY.08=     %name  - имя поля;
990038\DICMETAF.FUNC_BODY.09=     %value - значение (строка).
990038\DICMETAF.FUNC_BODY.10=   ----------------------------------------------------------------------------- */
990038\DICMETAF.FUNC_BODY.11=var v_text;
990038\DICMETAF.FUNC_BODY.12=v_text := _F_ENVLIGHT->flat(%value);
990038\DICMETAF.FUNC_BODY.13=if v_text <> '' then
990038\DICMETAF.FUNC_BODY.14=    ListAdd(%lines, %ind + %name + '=' + v_text);
990038\DICMETAF.FUNC_BODY.15=end
990038\DICMETAF.FUNC_BODY.COUNT=16
990038\DICMETAF.FUNC_HEADER.0=put_s( %lines:LargeInt; %ind:Str; %name:Str; %value )
990038\DICMETAF.FUNC_HEADER.COUNT=1
990038\DICMETAF.FUNC_ID=put_s
990038\DICMETAF.IS_CANON=0
990038\DICMETAF.IS_USER=1
990038\DICMETAF.MD5_HASH=dc9e3fcd71f0bfb9da171f1747d6d22e
990038\DICMETAF.MD5_STAMP=01.11.2026
990039\DICMETAF.FORM_NUM=990000
990039\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990039\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->put_z( %lines:LargeInt; %ind:Str; %name:Str; %value )
990039\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990039\DICMETAF.FUNC_BODY.03=   Добавить числовое поле, значение по умолчанию которого в базе - ноль:
990039\DICMETAF.FUNC_BODY.04=   NULL и 0 пропускаются, чтобы не засорять выгрузку.
990039\DICMETAF.FUNC_BODY.06=   Параметры: как у put_s; %value - число.
990039\DICMETAF.FUNC_BODY.07=   ----------------------------------------------------------------------------- */
990039\DICMETAF.FUNC_BODY.08=if ~IsBlank(%value) then
990039\DICMETAF.FUNC_BODY.09=    if %value <> 0 then
990039\DICMETAF.FUNC_BODY.10=        ListAdd(%lines, %ind + %name + '=' + Trim(Str(%value)));
990039\DICMETAF.FUNC_BODY.11=    end;
990039\DICMETAF.FUNC_BODY.12=end
990039\DICMETAF.FUNC_BODY.COUNT=13
990039\DICMETAF.FUNC_HEADER.0=put_z( %lines:LargeInt; %ind:Str; %name:Str; %value )
990039\DICMETAF.FUNC_HEADER.COUNT=1
990039\DICMETAF.FUNC_ID=put_z
990039\DICMETAF.IS_CANON=0
990039\DICMETAF.IS_USER=1
990039\DICMETAF.MD5_HASH=ab922fc252727a4b067d1da2297dfb79
990039\DICMETAF.MD5_STAMP=01.11.2026
990040\DICMETAF.FORM_NUM=990000
990040\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990040\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->ref_self( %id ):Int
990040\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990040\DICMETAF.FUNC_BODY.03=   Привести ссылку на лицо к SELF_ID. Хранимые в таблицах ссылки на лица
990040\DICMETAF.FUNC_BODY.04=   бывают на ID версии (OD_FACES.ID) или на SELF_ID; для первой версии они
990040\DICMETAF.FUNC_BODY.05=   совпадают.
990040\DICMETAF.FUNC_BODY.07=   Параметры: %id - ID лица.
990040\DICMETAF.FUNC_BODY.08=   Возврат: SELF_ID либо NULL, если лица нет или %id пустой.
990040\DICMETAF.FUNC_BODY.09=   ----------------------------------------------------------------------------- */
990040\DICMETAF.FUNC_BODY.10=var v_res;
990040\DICMETAF.FUNC_BODY.11=v_res := clear(0);
990040\DICMETAF.FUNC_BODY.12=if ~IsBlank(%id) then
990040\DICMETAF.FUNC_BODY.13=    v_res := Extract('Данные', [select max(SELF_ID) from OD_FACES where ID = :ID], %id);
990040\DICMETAF.FUNC_BODY.14=end;
990040\DICMETAF.FUNC_BODY.15=v_res
990040\DICMETAF.FUNC_BODY.COUNT=16
990040\DICMETAF.FUNC_HEADER.0=ref_self( %id ):Int
990040\DICMETAF.FUNC_HEADER.COUNT=1
990040\DICMETAF.FUNC_ID=ref_self
990040\DICMETAF.IS_CANON=0
990040\DICMETAF.IS_USER=1
990040\DICMETAF.MD5_HASH=e9a62babab3f14340557a541f604b2f5
990040\DICMETAF.MD5_STAMP=01.11.2026
990041\DICMETAF.FORM_NUM=990000
990041\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990041\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->share_self( %id ):Int
990041\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990041\DICMETAF.FUNC_BODY.03=   Привести ID финансового инструмента к SELF_ID (OD_VALUES.ID): принимается
990041\DICMETAF.FUNC_BODY.04=   и SELF_ID, и ID версии OD_SHARES.
990041\DICMETAF.FUNC_BODY.06=   Параметры: %id - ID инструмента или его версии.
990041\DICMETAF.FUNC_BODY.07=   Возврат: SELF_ID либо NULL, если инструмента нет.
990041\DICMETAF.FUNC_BODY.08=   ----------------------------------------------------------------------------- */
990041\DICMETAF.FUNC_BODY.09=var v_res;
990041\DICMETAF.FUNC_BODY.10=v_res := clear(0);
990041\DICMETAF.FUNC_BODY.11=if ~IsBlank(%id) then
990041\DICMETAF.FUNC_BODY.12=    v_res := Extract('Данные', [select max(SELF_ID) from OD_SHARES where SELF_ID = :SELF_ID], %id);
990041\DICMETAF.FUNC_BODY.13=    if IsBlank(v_res) then
990041\DICMETAF.FUNC_BODY.14=        v_res := Extract('Данные', [select max(SELF_ID) from OD_SHARES where ID = :ID], %id);
990041\DICMETAF.FUNC_BODY.15=    end;
990041\DICMETAF.FUNC_BODY.16=end;
990041\DICMETAF.FUNC_BODY.17=v_res
990041\DICMETAF.FUNC_BODY.COUNT=18
990041\DICMETAF.FUNC_HEADER.0=share_self( %id ):Int
990041\DICMETAF.FUNC_HEADER.COUNT=1
990041\DICMETAF.FUNC_ID=share_self
990041\DICMETAF.IS_CANON=0
990041\DICMETAF.IS_USER=1
990041\DICMETAF.MD5_HASH=f1107438102668fa026d6f9586b96012
990041\DICMETAF.MD5_STAMP=01.11.2026
990042\DICMETAF.FORM_NUM=990000
990042\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990042\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->xwalk_DIAL_MODE( %code:Int ):Str
990042\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990042\DICMETAF.FUNC_BODY.03=   Вид деятельности.
990042\DICMETAF.FUNC_BODY.04=   Обратное направление: код классификатора -> мнемоника env-light
990042\DICMETAF.FUNC_BODY.05=   (DIAL_MODE, cte/mnemonics.py). Неизвестный код возвращается числом как есть.
990042\DICMETAF.FUNC_BODY.07=   Параметры: %code - код (NUM в OD_SYS_TABS).
990042\DICMETAF.FUNC_BODY.08=   Возврат: мнемоника либо число строкой.
990042\DICMETAF.FUNC_BODY.09=   ----------------------------------------------------------------------------- */
990042\DICMETAF.FUNC_BODY.10=var v_res, v_key, LiX;
990042\DICMETAF.FUNC_BODY.11=v_key := Trim(Str(%code));
990042\DICMETAF.FUNC_BODY.12=LiX := List('0=registrar', '1=broker', '2=dealer', '3=fund_manager', '4=trust',
990042\DICMETAF.FUNC_BODY.13=            '5=depositary', '6=clearing', '7=exchange', '8=spec_depositary',
990042\DICMETAF.FUNC_BODY.14=            '9=spec_registrar', '12=transfer_agent', '13=uk_agent', '14=bank',
990042\DICMETAF.FUNC_BODY.15=            '18=insurance', '19=pif', '20=npf', '21=investment_fund', '34=advisor',
990042\DICMETAF.FUNC_BODY.16=            '38=foreign_info_system');
990042\DICMETAF.FUNC_BODY.17=v_res := ListVal(LiX, v_key);
990042\DICMETAF.FUNC_BODY.18=if IsBlank(v_res) then
990042\DICMETAF.FUNC_BODY.19=    v_res := v_key;
990042\DICMETAF.FUNC_BODY.20=end;
990042\DICMETAF.FUNC_BODY.21=v_res
990042\DICMETAF.FUNC_BODY.COUNT=22
990042\DICMETAF.FUNC_HEADER.0=xwalk_DIAL_MODE( %code:Int ):Str
990042\DICMETAF.FUNC_HEADER.COUNT=1
990042\DICMETAF.FUNC_ID=xwalk_DIAL_MODE
990042\DICMETAF.IS_CANON=0
990042\DICMETAF.IS_USER=1
990042\DICMETAF.MD5_HASH=c138ce0af558472582ac0c31ed010d6b
990042\DICMETAF.MD5_STAMP=01.11.2026
