990024\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990024\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_face_individual( %lines:LargeInt; %ind:Str; %id:Int )
990024\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990024\DICMETAF.FUNC_BODY.03=   Поля версии физлица из OD_F_FACES, в именах полей API_UPD_FACE.
990024\DICMETAF.FUNC_BODY.04=   Не выводится путь к фотографии (PHOTOFILE).
990024\DICMETAF.FUNC_BODY.06=   Параметры:
990024\DICMETAF.FUNC_BODY.07=     %lines - список строк выгрузки; %ind - отступ полей;
990024\DICMETAF.FUNC_BODY.08=     %id    - OD_FACES.ID версии лица (OD_F_FACES.FACE).
990024\DICMETAF.FUNC_BODY.09=   ----------------------------------------------------------------------------- */
990024\DICMETAF.FUNC_BODY.10=var SEX, PHONE_WORK, PENSNUM, ID_ERN, BIRTHPLACE, FIRSTNAME, PATRONYMIC, LASTNAME,
990024\DICMETAF.FUNC_BODY.11=    PUBMODE;
990024\DICMETAF.FUNC_BODY.12=for 'Данные' select [select SEX, PHONE_WORK, PENSNUM, ID_ERN, BIRTHPLACE, FIRSTNAME,
990024\DICMETAF.FUNC_BODY.13=                     PATRONYMIC, LASTNAME, PUBMODE
990024\DICMETAF.FUNC_BODY.14=                     from OD_F_FACES
990024\DICMETAF.FUNC_BODY.15=                     where FACE = :FACE]
990024\DICMETAF.FUNC_BODY.16=from %id
990024\DICMETAF.FUNC_BODY.17=into SEX, PHONE_WORK, PENSNUM, ID_ERN, BIRTHPLACE, FIRSTNAME, PATRONYMIC, LASTNAME,
990024\DICMETAF.FUNC_BODY.18=     PUBMODE
990024\DICMETAF.FUNC_BODY.19=do
990024\DICMETAF.FUNC_BODY.20=    _F_ENVLIGHT->put_s(%lines, %ind, 'SEX', SEX);
990024\DICMETAF.FUNC_BODY.21=    _F_ENVLIGHT->put_s(%lines, %ind, 'PHONE_WORK', PHONE_WORK);
990024\DICMETAF.FUNC_BODY.22=    _F_ENVLIGHT->put_s(%lines, %ind, 'PENSNUM', PENSNUM);
990024\DICMETAF.FUNC_BODY.23=    _F_ENVLIGHT->put_s(%lines, %ind, 'ID_ERN', ID_ERN);
990024\DICMETAF.FUNC_BODY.24=    _F_ENVLIGHT->put_s(%lines, %ind, 'BIRTHPLACE', BIRTHPLACE);
990024\DICMETAF.FUNC_BODY.25=    _F_ENVLIGHT->put_s(%lines, %ind, 'FIRSTNAME', FIRSTNAME);
990024\DICMETAF.FUNC_BODY.26=    _F_ENVLIGHT->put_s(%lines, %ind, 'PATRONYMIC', PATRONYMIC);
990024\DICMETAF.FUNC_BODY.27=    _F_ENVLIGHT->put_s(%lines, %ind, 'LASTNAME', LASTNAME);
990024\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_z(%lines, %ind, 'PUBMODE', PUBMODE);
990024\DICMETAF.FUNC_BODY.29=end
