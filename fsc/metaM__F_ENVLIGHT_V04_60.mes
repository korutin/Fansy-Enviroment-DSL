990023\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990023\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->out_face_common( %lines:LargeInt; %ind:Str; %id:Int )
990023\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990023\DICMETAF.FUNC_BODY.03=   Поля версии лица из OD_FACES (общие для физлица и юрлица), в именах
990023\DICMETAF.FUNC_BODY.04=   полей API_UPD_FACE. Не выводятся: ссылки на пользовательские справочники
990023\DICMETAF.FUNC_BODY.05=   (BRANCHES), пути к файлам (IMAGEFILE), служебные поля.
990023\DICMETAF.FUNC_BODY.07=   Параметры:
990023\DICMETAF.FUNC_BODY.08=     %lines - список строк выгрузки; %ind - отступ полей;
990023\DICMETAF.FUNC_BODY.09=     %id    - OD_FACES.ID версии лица.
990023\DICMETAF.FUNC_BODY.10=   ----------------------------------------------------------------------------- */
990023\DICMETAF.FUNC_BODY.11=var NAME, INN, TIN, KPP, MNEM, STATE, HOME_ADR, MAIL_ADR, FACT_ADR, HOME_KLADR,
990023\DICMETAF.FUNC_BODY.12=    MAIL_KLADR, FACT_KLADR, EMAIL, PHONE, FAX, TELEX, REGN, IS_NERES, PROFILE, TAXIS,
990023\DICMETAF.FUNC_BODY.13=    ENG_NAME, ENG_MAIL_ADR, DATE_DEPTH, DATE_BIRTH, DOC_TYPE, DOC_SER, DOC_NUM,
990023\DICMETAF.FUNC_BODY.14=    DOC_DAT, DOC_END, DOC_PLACE, DOC_CODE;
990023\DICMETAF.FUNC_BODY.15=for 'Данные' select [select NAME, INN, TIN, KPP, MNEM, STATE, HOME_ADR, MAIL_ADR, FACT_ADR,
990023\DICMETAF.FUNC_BODY.16=                     HOME_KLADR, MAIL_KLADR, FACT_KLADR, EMAIL, PHONE, FAX, TELEX,
990023\DICMETAF.FUNC_BODY.17=                     REGN, IS_NERES, PROFILE, TAXIS, ENG_NAME, ENG_MAIL_ADR,
990023\DICMETAF.FUNC_BODY.18=                     DATE_DEPTH, DATE_BIRTH, DOC_TYPE, DOC_SER, DOC_NUM, DOC_DAT,
990023\DICMETAF.FUNC_BODY.19=                     DOC_END, DOC_PLACE, DOC_CODE
990023\DICMETAF.FUNC_BODY.20=                     from OD_FACES
990023\DICMETAF.FUNC_BODY.21=                     where ID = :ID]
990023\DICMETAF.FUNC_BODY.22=from %id
990023\DICMETAF.FUNC_BODY.23=into NAME, INN, TIN, KPP, MNEM, STATE, HOME_ADR, MAIL_ADR, FACT_ADR, HOME_KLADR,
990023\DICMETAF.FUNC_BODY.24=     MAIL_KLADR, FACT_KLADR, EMAIL, PHONE, FAX, TELEX, REGN, IS_NERES, PROFILE, TAXIS,
990023\DICMETAF.FUNC_BODY.25=     ENG_NAME, ENG_MAIL_ADR, DATE_DEPTH, DATE_BIRTH, DOC_TYPE, DOC_SER, DOC_NUM,
990023\DICMETAF.FUNC_BODY.26=     DOC_DAT, DOC_END, DOC_PLACE, DOC_CODE
990023\DICMETAF.FUNC_BODY.27=do
990023\DICMETAF.FUNC_BODY.28=    _F_ENVLIGHT->put_s(%lines, %ind, 'NAME', NAME);
990023\DICMETAF.FUNC_BODY.29=    _F_ENVLIGHT->put_s(%lines, %ind, 'INN', INN);
990023\DICMETAF.FUNC_BODY.30=    _F_ENVLIGHT->put_s(%lines, %ind, 'TIN', TIN);
990023\DICMETAF.FUNC_BODY.31=    _F_ENVLIGHT->put_s(%lines, %ind, 'KPP', KPP);
990023\DICMETAF.FUNC_BODY.32=    _F_ENVLIGHT->put_s(%lines, %ind, 'MNEM', MNEM);
990023\DICMETAF.FUNC_BODY.33=    _F_ENVLIGHT->put_s(%lines, %ind, 'STATE', STATE);
990023\DICMETAF.FUNC_BODY.34=    _F_ENVLIGHT->put_s(%lines, %ind, 'HOME_ADR', HOME_ADR);
990023\DICMETAF.FUNC_BODY.35=    _F_ENVLIGHT->put_s(%lines, %ind, 'MAIL_ADR', MAIL_ADR);
990023\DICMETAF.FUNC_BODY.36=    _F_ENVLIGHT->put_s(%lines, %ind, 'FACT_ADR', FACT_ADR);
990023\DICMETAF.FUNC_BODY.37=    _F_ENVLIGHT->put_s(%lines, %ind, 'HOME_KLADR', HOME_KLADR);
990023\DICMETAF.FUNC_BODY.38=    _F_ENVLIGHT->put_s(%lines, %ind, 'MAIL_KLADR', MAIL_KLADR);
990023\DICMETAF.FUNC_BODY.39=    _F_ENVLIGHT->put_s(%lines, %ind, 'FACT_KLADR', FACT_KLADR);
990023\DICMETAF.FUNC_BODY.40=    _F_ENVLIGHT->put_s(%lines, %ind, 'EMAIL', EMAIL);
990023\DICMETAF.FUNC_BODY.41=    _F_ENVLIGHT->put_s(%lines, %ind, 'PHONE', PHONE);
990023\DICMETAF.FUNC_BODY.42=    _F_ENVLIGHT->put_s(%lines, %ind, 'FAX', FAX);
990023\DICMETAF.FUNC_BODY.43=    _F_ENVLIGHT->put_s(%lines, %ind, 'TELEX', TELEX);
990023\DICMETAF.FUNC_BODY.44=    _F_ENVLIGHT->put_n(%lines, %ind, 'REGN', REGN);
990023\DICMETAF.FUNC_BODY.45=    _F_ENVLIGHT->put_z(%lines, %ind, 'IS_NERES', IS_NERES);
990023\DICMETAF.FUNC_BODY.46=    _F_ENVLIGHT->put_z(%lines, %ind, 'PROFILE', PROFILE);
990023\DICMETAF.FUNC_BODY.47=    _F_ENVLIGHT->put_s(%lines, %ind, 'TAXIS', TAXIS);
990023\DICMETAF.FUNC_BODY.48=    _F_ENVLIGHT->put_s(%lines, %ind, 'ENG_NAME', ENG_NAME);
990023\DICMETAF.FUNC_BODY.49=    _F_ENVLIGHT->put_s(%lines, %ind, 'ENG_MAIL_ADR', ENG_MAIL_ADR);
990023\DICMETAF.FUNC_BODY.50=    _F_ENVLIGHT->put_d(%lines, %ind, 'DATE_DEPTH', DATE_DEPTH);
990023\DICMETAF.FUNC_BODY.51=    _F_ENVLIGHT->put_d(%lines, %ind, 'DATE_BIRTH', DATE_BIRTH);
990023\DICMETAF.FUNC_BODY.52=    _F_ENVLIGHT->put_z(%lines, %ind, 'DOC_TYPE', DOC_TYPE);
990023\DICMETAF.FUNC_BODY.53=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOC_SER', DOC_SER);
990023\DICMETAF.FUNC_BODY.54=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOC_NUM', DOC_NUM);
990023\DICMETAF.FUNC_BODY.55=    _F_ENVLIGHT->put_d(%lines, %ind, 'DOC_DAT', DOC_DAT);
990023\DICMETAF.FUNC_BODY.56=    _F_ENVLIGHT->put_d(%lines, %ind, 'DOC_END', DOC_END);
990023\DICMETAF.FUNC_BODY.57=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOC_PLACE', DOC_PLACE);
990023\DICMETAF.FUNC_BODY.58=    _F_ENVLIGHT->put_s(%lines, %ind, 'DOC_CODE', DOC_CODE);
990023\DICMETAF.FUNC_BODY.59=end
