990044\DICMETAF.FUNC_BODY.00=/* -----------------------------------------------------------------------------
990044\DICMETAF.FUNC_BODY.01=   _F_ENVLIGHT->xwalk_SHARE_CLASS( %code:Int ):Str
990044\DICMETAF.FUNC_BODY.02=   -----------------------------------------------------------------------------
990044\DICMETAF.FUNC_BODY.03=   Вид финансового инструмента.
990044\DICMETAF.FUNC_BODY.04=   Обратное направление: код классификатора -> мнемоника env-light
990044\DICMETAF.FUNC_BODY.05=   (SHARE_CLASS, cte/mnemonics.py). Неизвестный код возвращается числом как есть.
990044\DICMETAF.FUNC_BODY.07=   Параметры: %code - код (NUM в OD_SYS_TABS).
990044\DICMETAF.FUNC_BODY.08=   Возврат: мнемоника либо число строкой.
990044\DICMETAF.FUNC_BODY.09=   ----------------------------------------------------------------------------- */
990044\DICMETAF.FUNC_BODY.10=var v_res, v_key, LiX;
990044\DICMETAF.FUNC_BODY.11=v_key := Trim(Str(%code));
990044\DICMETAF.FUNC_BODY.12=LiX := List('1=stock', '2=bond', '3=bill', '4=option', '5=future', '6=bank_cert',
990044\DICMETAF.FUNC_BODY.13=            '7=dr', '8=bill_of_lading', '9=warrant', '10=unit', '11=ooo_capital',
990044\DICMETAF.FUNC_BODY.14=            '12=mortgage_cert', '13=mortgage_part', '14=clearing_cert',
990044\DICMETAF.FUNC_BODY.15=            '15=digital_asset', '16=digital_cert', '17=crypto');
990044\DICMETAF.FUNC_BODY.16=v_res := ListVal(LiX, v_key);
990044\DICMETAF.FUNC_BODY.17=if IsBlank(v_res) then
990044\DICMETAF.FUNC_BODY.18=    v_res := v_key;
990044\DICMETAF.FUNC_BODY.19=end;
990044\DICMETAF.FUNC_BODY.20=v_res
990044\DICMETAF.FUNC_BODY.COUNT=21
