# Пример тестового окружения: эмитент, физлицо (с исторической правкой),
# финансовый инструмент, лицевой счёт владельца, банк и банковский счёт.
#
# Банк — юрлицо плюс запись OD_BANKS: поля лица (NAME, INN, ...) и поля банка
# (BIC, KORR, CITY, SWIFT, ...) пишутся в одном блоке, см. README, раздел
# <<Блок bank>>. Сценарий можно проверить без БД: --dry-run.

face &gazprom: juridical
  NAME=ПАО Газпром
  INN=7736050003

face &ivanov: individual
  NAME=Иванов Иван Иванович
  INN=770123456789

# Историческая правка лица — смена документа с 2020-06-01
face &ivanov: individual
  as_of=2020-06-01
  NAME=Иванов Иван Иванович
  DOC_SER=45 05
  DOC_NUM=123456

share &gazp: stock
  SYSNAME=GAZP
  ISSUER=&gazprom
  ISIN=RU0007661625

client &ivanov_owner: owner
  NUMBER=Т0001
  FACE=&ivanov
  ISSUER=&gazprom

bank &sber
  NAME=ПАО Сбербанк
  INN=7707083893
  BIC=044525225
  KORR=30101810400000000225
  CITY=Москва
  # лицензия банка — обычный вложенный блок activity
  activity: bank
    NUM_LIC=1481
    BEG_LIC=1990-01-01

bank_account &ivanov_bank_acc
  ACNT=40817810900000012345
  BIC=044525225
  FACE=&ivanov
