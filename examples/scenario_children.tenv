# Пример множественных атрибутов лица и лицевого счёта.
#
# Внимание: из четырёх коллекций реально работает только `code`
# (API_SET_FC_CODE существует в платформе). `activity` вызывает заглушку
# API_SET_P_FACE — вызов пройдёт, но в базе ничего не появится, движок
# предупредит об этом. `attorney` и `affiliate` упираются в заглушки,
# возвращающие NULL, и сценарий на них остановится с ошибкой — это
# ожидаемое поведение до реализации процедур.

face &nsd: juridical
  NAME=НКО АО НРД
  INN=7702165310

face &petrov: individual
  NAME=Петров Пётр Петрович
  INN=770987654321

face &ivanov: individual
  NAME=Иванов Иван Иванович
  INN=770123456789

  # код лица глазами НРД (кодировщик задан алиасом)
  code: &nsd
    CODE=NDC000123

  # код у кодировщика, заданного мнемоникой
  code: micex
    CODE=MX987

  # вид деятельности без лицензии и с лицензией
  activity: broker
  activity: depositary
    NUM_LIC=045-12042-000100
    BEG_LIC=2012-12-04
    PLACE_LIC=ФСФР России

  # уполномоченный без записи в справочнике лиц
  attorney
    NAME=Сидоров С.С.
    DUTY=Генеральный директор
    DOC_NUM=12/2020
    B_DATE=2020-01-01

  # уполномоченный, который есть в справочнике
  attorney: &petrov
    DUTY=Заместитель директора
    B_DATE=2021-03-01

client &ivanov_owner: owner
  NUMBER=Т0001
  FACE=&ivanov

  # аффилированное лицо висит на ЛИЦЕВОМ СЧЁТЕ, не на лице
  affiliate: &petrov
    RELATION=1
    NUMERATOR=1
    DENOMINATOR=4
    B_DATE=2020-01-01
